# Copy to `.env` and tweak. `.env` is gitignored.

# URL of the Minecraft Education Linux dedicated server zip.
# Default: Microsoft's "always latest" redirect.
# To pin a specific version (recommended for reproducible builds), set
# this to the resolved CDN URL, e.g.:
#   https://downloads.minecrafteduservices.com/retailbuilds/LinuxDS/MinecraftEducation_LinuxDS_1.21.133.2.zip
BUNDLE_URL=https://aka.ms/downloadmee-linuxserver

# Optional but recommended when BUNDLE_URL is pinned: SHA-256 of the zip.
# Compute with: sha256sum MinecraftEducation_LinuxDS_*.zip
# Known good for MEE 1.21.133.2:
#   73463c1b13ce6021668b85ace3cd4c19dfb6545003e2e41196a5e9815338b26a
BUNDLE_SHA256=

# Host UDP port published to clients. Must match server-port in
# data/server.properties (the bundle ships with 20202).
MCEDU_PORT=20202

# Host UDP port for LAN visibility — the server also binds 19132.
MCEDU_LAN_PORT=19132

# Image tag used by `docker compose build`.
IMAGE_TAG=local
